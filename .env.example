# Kết nối MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=personal_site_app
DB_PASSWORD=
DB_NAME=personal_site

# Chuỗi ngẫu nhiên dài từ 32 ký tự trở lên, dùng để ký phiên đăng nhập
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Địa chỉ website (dùng cho đăng nhập Google/Facebook). Khi đưa lên mạng, đổi thành tên miền thật.
APP_URL=http://localhost:3000

# Đăng nhập Google (tùy chọn, để trống thì nút Google báo "chưa được bật")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng nhập Facebook (tùy chọn)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Thư mục lưu ảnh tải lên (mặc định ./uploads)
# UPLOAD_DIR=./uploads

# Gửi email quên mật khẩu qua SMTP (tùy chọn). Để trống thì không tạo/gửi reset link và không log nội dung.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Railway staging: cấu hình qua Variables, không đưa .env.local vào image.
# APP_ENV=staging
# APP_URL=https://ten-mien-staging-cua-ban
# UPLOAD_DIR=/app/uploads
# STAGING_AUTH_USERNAME=
# STAGING_AUTH_PASSWORD= (secret riêng ít nhất 20 ký tự)
# Railway tự cấp PORT và RAILWAY_VOLUME_MOUNT_PATH khi mount volume.
