# Ignore SQL dumps by default. Only reviewed schema/migration sources belong here.
# Review and extend this allowlist when adding a new migration.
*.sql
!/sql/001_home_settings.sql
!/sql/002_users.sql
!/sql/003_content.sql
!/sql/004_blueprint.sql
!/sql/planned/000_review_preflight.sql
!/sql/planned/006_blog_foundation.sql
!/sql/planned/007_discovery_community.sql
!/sql/planned/008_journeystory_maps.sql

# Dependencies, generated files, caches and logs.
node_modules/
.next/
out/
dist/
build/
coverage/
.cache/
.turbo/
.vercel/
.npm/
.eslintcache
next-env.d.ts
*.tsbuildinfo
# Runtime logs at project root; src/app/admin/logs is application source.
/logs/
*.log
*.log.*
*.pid
*.pid.lock
*.stackdump
*.tmp
*.temp
.DS_Store
Thumbs.db
Desktop.ini

# Keep safe, reviewed examples; never unignore private storage directories.
!*.example
!.env.example
!.env.*.example
